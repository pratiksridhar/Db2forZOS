{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/db2-for-zos/ofs-test-case.schema.json",
  "title": "Db2 for z/OS OFS DDL test case",
  "description": "Persistent test record for source execution, OFS generation, clean-name recreation, and semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "object",
    "category",
    "status",
    "product_context",
    "source_refs",
    "variation",
    "action_sql",
    "expected",
    "ofs_validation",
    "cleanup_sql"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^DB2Z13-(STOGROUP|DATABASE|TABLESPACE|TABLE|INDEX|TRIGGER)-[A-Z0-9-]+-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "object": {
      "enum": ["stogroup", "database", "tablespace", "table", "index", "trigger"]
    },
    "category": {
      "enum": [
        "positive",
        "negative",
        "boundary",
        "default",
        "interaction",
        "round_trip",
        "dependency",
        "operational"
      ]
    },
    "status": {
      "enum": ["design", "ready", "pass", "fail", "blocked", "retired"]
    },
    "product_context": {
      "$ref": "#/$defs/product_context"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ibm-[a-z0-9-]+$"
      }
    },
    "variation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_clause", "dimensions", "explicitness"],
      "properties": {
        "primary_clause": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "explicitness": {
          "enum": ["omitted", "explicit_default", "explicit_nondefault", "not_applicable"]
        },
        "boundary_position": {
          "enum": ["minimum", "maximum", "below_minimum", "above_maximum", "not_applicable"]
        },
        "companion_case_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "prerequisites": {
      "type": "array",
      "items": {"type": "string"}
    },
    "setup_sql": {
      "$ref": "#/$defs/sql_array"
    },
    "setup_sql_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "action_sql": {
      "$ref": "#/$defs/sql_array"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "failure_phase", "catalog_assertions"],
      "properties": {
        "outcome": {
          "enum": ["success", "sql_error", "operational_error", "ofs_error"]
        },
        "failure_phase": {
          "enum": [
            "none",
            "prepare_or_execute",
            "data_set_allocation",
            "data_change",
            "rebuild_or_utility",
            "ofs_generation",
            "recreate"
          ]
        },
        "sqlcode": {"type": ["integer", "null"]},
        "sqlstate": {"type": ["string", "null"]},
        "catalog_assertions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "notes": {"type": "string"}
      }
    },
    "ofs_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_target",
        "name_map",
        "generated_ddl_must_include",
        "generated_ddl_must_exclude",
        "comparison_policy"
      ],
      "properties": {
        "generation_target": {"type": "string", "minLength": 1},
        "generation_options": {
          "type": "object",
          "additionalProperties": true
        },
        "name_map": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        },
        "generated_ddl_must_include": {
          "type": "array",
          "items": {"type": "string"}
        },
        "generated_ddl_must_exclude": {
          "type": "array",
          "items": {"type": "string"}
        },
        "comparison_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_fields", "ignored_fields"],
          "properties": {
            "semantic_fields": {
              "type": "array",
              "items": {"type": "string"}
            },
            "ignored_fields": {
              "type": "array",
              "items": {"type": "string"}
            },
            "notes": {"type": "string"}
          }
        }
      }
    },
    "cleanup_sql": {
      "$ref": "#/$defs/sql_array"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  },
  "$defs": {
    "sql_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "product_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "function_level",
        "applcompat",
        "current_rules",
        "data_sharing",
        "subsystem_parameters"
      ],
      "properties": {
        "release": {"const": "Db2 13 for z/OS"},
        "function_level": {"type": "string", "minLength": 1},
        "applcompat": {"type": "string", "minLength": 1},
        "current_rules": {"enum": ["DB2", "STD"]},
        "data_sharing": {"type": "boolean"},
        "member": {"type": ["string", "null"]},
        "subsystem_parameters": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
        },
        "active_buffer_pools": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "storage_context": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
        }
      }
    }
  }
}
