{
  "schema_version": "1.0.0",
  "purpose": "Minimum syntax variety for a QA schema that is meant to exercise DDL extraction. Many objects with one repeated option set exercise the product's same code paths; these requirements force distinct catalog states. Features are normalized KB clause IDs (object.clause) or derived facets (facet:name). <omitted> counts as a value so omitted and explicit forms are both exercised.",
  "baselines": [
    {
      "id": "core",
      "description": "Feasible in one database with active 4 KB pools, CURRENT RULES DB2 and no special storage, security or accelerator setup. Use it for every domain schema unless the request says otherwise.",
      "requirements": [
        {"feature": "facet:tablespace.type", "values": ["PBG", "PBR"], "note": "At least one partition-by-growth and one partition-by-range table space."},
        {"feature": "tablespace.segsize", "min_distinct": 3, "note": "For example omitted, 4 and 64."},
        {"feature": "tablespace.dssize", "min_distinct": 2},
        {"feature": "tablespace.locksize", "min_distinct": 3},
        {"feature": "tablespace.lockmax", "min_distinct": 2},
        {"feature": "tablespace.compress", "min_distinct": 2},
        {"feature": "tablespace.freepage", "min_distinct": 2},
        {"feature": "tablespace.pctfree", "min_distinct": 2},
        {"feature": "tablespace.pctfree-for-update", "min_distinct": 2},
        {"feature": "tablespace.maxrows", "min_distinct": 2},
        {"feature": "tablespace.close", "min_distinct": 2},
        {"feature": "tablespace.trackmod", "min_distinct": 2},
        {"feature": "tablespace.ccsid", "min_distinct": 2},
        {"feature": "tablespace.member-cluster", "specified": true},
        {"feature": "tablespace.partition-block", "specified": true, "note": "PBR partition-level overrides."},
        {"feature": "table.data-type", "min_distinct": 12, "count_omitted": false, "note": "Distinct built-in type families."},
        {"feature": "table.default", "min_distinct": 4, "note": "Constant, NULL, value-less WITH DEFAULT, USER/CURRENT SQLID, omitted."},
        {"feature": "table.identity", "values": ["ALWAYS", "BY DEFAULT"]},
        {"feature": "table.row-change-timestamp", "specified": true},
        {"feature": "table.implicitly-hidden", "specified": true},
        {"feature": "table.primary-key", "specified": true},
        {"feature": "table.unique", "specified": true},
        {"feature": "table.foreign-key", "min_distinct": 3, "note": "Several delete rules, including omitted."},
        {"feature": "facet:foreign-key.enforced", "values": ["ENFORCED", "NOT ENFORCED"]},
        {"feature": "facet:foreign-key.columns", "values": ["single", "composite"]},
        {"feature": "table.check", "specified": true},
        {"feature": "table.column-constraint", "specified": true, "note": "At least one column-level constraint spelling."},
        {"feature": "table.partition-by-range", "specified": true},
        {"feature": "table.audit", "min_distinct": 3},
        {"feature": "table.data-capture", "min_distinct": 2},
        {"feature": "table.append", "min_distinct": 2},
        {"feature": "table.volatile", "min_distinct": 2},
        {"feature": "facet:table.placement", "values": ["explicit", "implicit-in-database"]},
        {"feature": "facet:table.lob-support", "any_of": ["explicit", "implicit"], "note": "At least one LOB column with its support objects."},
        {"feature": "index.unique", "min_distinct": 2},
        {"feature": "index.where-not-null", "specified": true},
        {"feature": "index.include", "specified": true},
        {"feature": "index.key-order", "min_distinct": 2, "count_omitted": false, "note": "ASC and DESC."},
        {"feature": "index.cluster", "min_distinct": 2},
        {"feature": "index.padding", "min_distinct": 2},
        {"feature": "index.partitioned", "specified": true},
        {"feature": "index.freepage", "min_distinct": 2},
        {"feature": "index.pctfree", "min_distinct": 2}
      ]
    },
    {
      "id": "extended",
      "description": "Core plus features that need extra environment: 8/16/32 KB pools, compression-capable index pools, temporal history tables, XML support objects, RANDOM keys and expression indexes. Record the profile values before execution.",
      "extends": "core",
      "requirements": [
        {"feature": "facet:tablespace.type", "values": ["PBG", "PBR", "LOB"]},
        {"feature": "facet:tablespace.page-size", "min_distinct": 2, "count_omitted": false, "note": "Needs an active 8, 16 or 32 KB pool."},
        {"feature": "tablespace.pagenum", "specified": true},
        {"feature": "tablespace.insert-algorithm", "min_distinct": 2},
        {"feature": "table.data-type", "min_distinct": 18, "count_omitted": false},
        {"feature": "table.business-period", "specified": true},
        {"feature": "table.row-begin", "specified": true},
        {"feature": "table.transaction-start-id", "specified": true},
        {"feature": "table.rowid", "specified": true},
        {"feature": "table.inline-length", "specified": true},
        {"feature": "facet:table.lob-support", "values": ["explicit", "implicit"]},
        {"feature": "facet:table.placement", "values": ["explicit", "implicit-in-database", "fully-implicit"]},
        {"feature": "index.key-order", "values": ["ASC", "DESC", "RANDOM"]},
        {"feature": "index.expression-key", "specified": true},
        {"feature": "index.null-keys", "min_distinct": 2},
        {"feature": "index.compress", "min_distinct": 2, "note": "Index compression needs an 8, 16 or 32 KB index buffer pool."},
        {"feature": "index.business-time", "specified": true},
        {"feature": "index.copy", "min_distinct": 2}
      ]
    }
  ]
}
