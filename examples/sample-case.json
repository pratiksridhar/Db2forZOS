  ],
  "setup_sql": [],
  "action_sql": [
    "CREATE TABLESPACE OFSTSP01 IN OFSDB001 BUFFERPOOL BP0 NUMPARTS 4 PAGENUM RELATIVE DSSIZE 8 G SEGSIZE 32 USING STOGROUP OFSSG001 PRIQTY -1 SECQTY -1 ERASE NO",
    "COMMIT"
  ],
  "expected": {
    "outcome": "success",
    "failure_phase": "none",
    "sqlcode": 0,
    "sqlstate": "00000",
    "catalog_assertions": [
